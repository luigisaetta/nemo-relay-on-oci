# Copy to demos/order_fulfillment_responses/.env from the repository root.
# Existing process environment variables take precedence over this file.
OCI_REGION=eu-frankfurt-1
MODEL_ID=openai.gpt-5.6-sol
OCI_COMPARTMENT_ID=replace-with-your-compartment-ocid
OCI_AUTH_TYPE=API_KEY
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Optional and model-dependent; blank omits reasoning. Verify supported values
# for the selected model before enabling it.
OCI_REASONING_EFFORT=

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=order-fulfillment-responses
MODEL_PRICING_FILE=demos/order_fulfillment_responses/pricing.example.json
PII_REDACTION=mask
PROMPT_GUARD=combined
OCI_GUARDRAIL_VERSION=1.1.3
PROMPT_GUARD_ON_ERROR=allow
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INGESTION_VERSION=4
