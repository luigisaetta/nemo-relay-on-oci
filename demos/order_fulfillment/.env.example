# Copy to demos/order_fulfillment/.env from the repository root.
# Existing process environment variables take precedence over .env values.

# Required: select a region where your chosen model is available.
# The inference endpoint is derived from OCI_REGION; no endpoint variable is needed.
OCI_REGION=us-chicago-1
MODEL_ID=replace-with-your-model-id
OCI_COMPARTMENT_ID=replace-with-your-compartment-ocid

# Supported modes: API_KEY or RESOURCE_PRINCIPAL.
OCI_AUTH_TYPE=API_KEY

# API_KEY only: the OCI config references the local user's private signing key.
# Never put the private key or its contents in this file.
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# For RESOURCE_PRINCIPAL, change OCI_AUTH_TYPE and remove the two config lines
# above. Credentials must be supplied by the OCI runtime.
# Structured output support depends on the chosen model.
# Options: function_calling, json_schema, json_mode.
OCI_STRUCTURED_OUTPUT_METHOD=function_calling

# Optional: leave empty to disable trace export.
# For a local collector: http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=order-fulfillment
